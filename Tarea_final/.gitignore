# --- Secretos / credenciales (CRÍTICO) ---
.env
.env.*
*.env
!.env.example
*.key
secrets.*

# --- Bases de datos vectoriales generadas (ChromaDB) ---
*.bin

# --- Python / Jupyter ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/

# --- Sistema operativo ---
.DS_Store
Thumbs.db

# --- Claude
.claude
